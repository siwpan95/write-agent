# ============================================================
# 小说创作智能 Agent · 环境变量样例
# 复制为 .env 后填入真实值： cp .env.example .env
# ============================================================

# ===== 大模型接入（OpenAI 兼容协议，默认 DeepSeek）=====
# 任意 OpenAI 兼容端点均可：DeepSeek / OpenAI / 通义 / 本地 Ollama 等
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8

# 无 Key 本地演示 / CI 测试开关：
#   true  -> LLM 层返回结构化占位响应，全链路（含 KB 检索与引用）可跑通
#   false -> 真实调用 LLM_BASE_URL
MOCK_LLM=false

# ===== 知识库（默认仅 BM25，无需联网/无需 embeddings）=====
# 索引来源：写作工作区（通用模板包 / 参考资料 / 点子库 / 各书 bible 等）
KB_ROOT=G:/repos/write
KB_TOP_K=6
# 相关性闸门：命中需同时通过「归一化 BM25 分数」与「查询词覆盖率」，否则判为未查到
KB_RELEVANCE_MIN=0.3
KB_COVERAGE_MIN=0.3

# 可选：稠密向量检索（提升语义召回）。留空则仅用 BM25。
# 启用步骤：1) 填下方三项  2) 设 KB_USE_EMBED=true
KB_USE_EMBED=false
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
